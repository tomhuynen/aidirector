{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
    {
        "type": "composer",
        "url": "https://satis.inertiaui.com"
    }
],
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^2.0",
        "inertiaui/modal": "^0.21.1",
        "inertiaui/table": "^3.0",
        "kirschbaum-development/eloquent-power-joins": "^4.2",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.33",
        "laravel/prompts": "^0.3.5",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.29",
        "league/flysystem-path-prefixing": "^3.28",
        "matomo/device-detector": "^6.4",
        "opcodesio/log-viewer": "^3.18",
        "red-explosion/laravel-sqids": "^1.3",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-multitenancy": "^4.0",
        "spatie/laravel-notification-log": "^1.3",
        "spatie/laravel-passkeys": "^1.0",
        "spatie/laravel-permission": "^6.19",
        "symfony/finder": "^7.3",
        "symfony/yaml": "^7.3",
        "web-auth/webauthn-lib": "^5.2"
    },
    "require-dev": {
        "dedoc/scramble": "^0.12.19",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.4",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.22",
        "laravel/sail": "^1.41",
        "laravel/telescope": "*",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "overtrue/phplint": "^9.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyze": [
            "./vendor/bin/phpstan --memory-limit=3G"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
